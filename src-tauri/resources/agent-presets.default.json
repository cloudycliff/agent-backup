{
  "version": 1,
  "agents": [
    {
      "key": "cursor",
      "label": "Cursor",
      "root": {
        "kind": "home_subdir",
        "win": ".cursor",
        "mac": ".cursor",
        "env_override": null
      },
      "groups": [
        {
          "id": "config",
          "label": "配置",
          "default_enabled": true,
          "include": [
            "mcp.json",
            "argv.json",
            "ide_state.json",
            "unified_repo_list.json",
            ".gitignore"
          ]
        },
        {
          "id": "rules",
          "label": "Rules",
          "default_enabled": true,
          "include": ["rules/"]
        },
        {
          "id": "skills",
          "label": "Skills",
          "default_enabled": true,
          "include": ["skills/", "skills-cursor/"]
        },
        {
          "id": "agents",
          "label": "Agents",
          "default_enabled": true,
          "include": ["agents/"]
        },
        {
          "id": "hooks",
          "label": "Hooks",
          "default_enabled": true,
          "include": ["hooks/"]
        },
        {
          "id": "plugins",
          "label": "Plugins",
          "default_enabled": false,
          "include": ["plugins/"]
        },
        {
          "id": "sessions",
          "label": "会话与项目状态",
          "default_enabled": false,
          "include": ["projects/", "plans/", "ai-tracking/"]
        }
      ],
      "hard_exclude": []
    },
    {
      "key": "claude-code",
      "label": "Claude Code",
      "root": {
        "kind": "home_subdir",
        "win": ".claude",
        "mac": ".claude",
        "env_override": null
      },
      "groups": [
        {
          "id": "config",
          "label": "配置",
          "default_enabled": true,
          "include": ["settings.json", ".mcp.json", "CLAUDE.md"]
        },
        {
          "id": "rules",
          "label": "Rules",
          "default_enabled": true,
          "include": ["rules/"]
        },
        {
          "id": "skills",
          "label": "Skills",
          "default_enabled": true,
          "include": ["skills/"]
        },
        {
          "id": "hooks",
          "label": "Hooks",
          "default_enabled": true,
          "include": ["hooks/"]
        },
        {
          "id": "agents",
          "label": "Agents",
          "default_enabled": true,
          "include": ["agents/"]
        },
        {
          "id": "sessions",
          "label": "会话与项目状态",
          "default_enabled": false,
          "include": ["sessions/", "transcripts/", "projects/"]
        }
      ],
      "hard_exclude": ["backups/"]
    },
    {
      "key": "codex",
      "label": "Codex",
      "root": {
        "kind": "home_subdir",
        "win": ".codex",
        "mac": ".codex",
        "env_override": null
      },
      "groups": [
        {
          "id": "config",
          "label": "配置",
          "default_enabled": true,
          "include": [
            "config.toml",
            "AGENTS.md",
            ".codex-global-state.json"
          ]
        },
        {
          "id": "skills",
          "label": "Skills",
          "default_enabled": true,
          "include": ["skills/"]
        },
        {
          "id": "rules",
          "label": "Rules",
          "default_enabled": true,
          "include": ["rules/"]
        },
        {
          "id": "plugins",
          "label": "Plugins",
          "default_enabled": false,
          "include": ["plugins/"]
        },
        {
          "id": "memories",
          "label": "Memories",
          "default_enabled": false,
          "include": ["memories/"]
        },
        {
          "id": "sessions",
          "label": "会话",
          "default_enabled": false,
          "include": [
            "sessions/",
            "archived_sessions/",
            "dictation-history/"
          ]
        }
      ],
      "hard_exclude": [
        "auth.json",
        ".sandbox-secrets/",
        ".sandbox/",
        ".sandbox-bin/",
        "tmp/",
        ".tmp/",
        "*.sqlite",
        "*.sqlite-shm",
        "*.sqlite-wal"
      ]
    },
    {
      "key": "workbuddy",
      "label": "Workbuddy",
      "root": {
        "kind": "home_subdir",
        "win": ".workbuddy",
        "mac": ".workbuddy",
        "env_override": "WORKBUDDY_CONFIG_DIR"
      },
      "groups": [
        {
          "id": "config",
          "label": "配置",
          "default_enabled": true,
          "include": [
            ".mcp.json",
            "models.json",
            "CODEBUDDY.md",
            "MEMORY.md"
          ]
        },
        {
          "id": "skills",
          "label": "Skills",
          "default_enabled": true,
          "include": ["skills/"]
        },
        {
          "id": "experts",
          "label": "Experts",
          "default_enabled": true,
          "include": ["experts/"]
        },
        {
          "id": "plugins",
          "label": "Plugins / Connectors",
          "default_enabled": false,
          "include": [
            "plugins/",
            "connectors/",
            "connectors-marketplace/"
          ]
        },
        {
          "id": "memory",
          "label": "Memory",
          "default_enabled": false,
          "include": ["memory/"]
        },
        {
          "id": "sessions",
          "label": "会话与项目状态",
          "default_enabled": false,
          "include": [
            "sessions/",
            "projects/",
            "plans/",
            "tasks/",
            "traces/"
          ]
        }
      ],
      "hard_exclude": [
        "credentials/",
        "logs/",
        "binaries/",
        "blobs/",
        "vendor/",
        "local_storage/",
        "clipboard-images/",
        ".workbuddy-sqlite-migrations/",
        "shell-snapshots/",
        "artifact-index/",
        "audit-log/",
        "pending-telemetry/",
        "*.sqlite",
        "*.sqlite-shm",
        "*.sqlite-wal"
      ]
    },
    {
      "key": "windsurf",
      "label": "Windsurf",
      "root": {
        "kind": "home_subdir",
        "win": ".codeium/windsurf",
        "mac": ".codeium/windsurf",
        "env_override": null
      },
      "groups": [
        {
          "id": "config",
          "label": "配置",
          "default_enabled": true,
          "include": ["mcp_config.json", "user_settings.pb"]
        },
        {
          "id": "rules",
          "label": "Rules",
          "default_enabled": true,
          "include": ["rules/", "memories/global_rules.md"]
        },
        {
          "id": "skills",
          "label": "Skills",
          "default_enabled": true,
          "include": ["skills/"]
        },
        {
          "id": "workflows",
          "label": "Workflows",
          "default_enabled": true,
          "include": ["global_workflows/"]
        },
        {
          "id": "memories",
          "label": "Memories",
          "default_enabled": false,
          "include": ["memories/"]
        }
      ],
      "hard_exclude": ["*.log", "cache/"]
    },
    {
      "key": "continue",
      "label": "Continue",
      "root": {
        "kind": "home_subdir",
        "win": ".continue",
        "mac": ".continue",
        "env_override": null
      },
      "groups": [
        {
          "id": "config",
          "label": "配置",
          "default_enabled": true,
          "include": [
            "config.json",
            "config.ts",
            "config.yaml",
            "config.yml",
            ".continuerc.json"
          ]
        },
        {
          "id": "skills",
          "label": "Skills / Prompts",
          "default_enabled": true,
          "include": ["skills/", "prompts/", "rules/"]
        },
        {
          "id": "assistants",
          "label": "Assistants",
          "default_enabled": true,
          "include": ["assistants/", "agents/"]
        },
        {
          "id": "sessions",
          "label": "会话 / 索引",
          "default_enabled": false,
          "include": ["sessions/", "index/", "dev_data/"]
        }
      ],
      "hard_exclude": ["index/", "*.sqlite", "*.sqlite-shm", "*.sqlite-wal"]
    },
    {
      "key": "cline",
      "label": "Cline",
      "root": {
        "kind": "home_subdir",
        "win": ".cline",
        "mac": ".cline",
        "env_override": null
      },
      "groups": [
        {
          "id": "config",
          "label": "配置与数据",
          "default_enabled": true,
          "include": ["data/", "settings/", "config/"]
        },
        {
          "id": "tasks",
          "label": "任务历史",
          "default_enabled": false,
          "include": ["tasks/", "history/"]
        }
      ],
      "hard_exclude": ["cache/", "*.log"]
    },
    {
      "key": "kiro",
      "label": "Kiro",
      "root": {
        "kind": "home_subdir",
        "win": ".kiro",
        "mac": ".kiro",
        "env_override": null
      },
      "groups": [
        {
          "id": "config",
          "label": "配置",
          "default_enabled": true,
          "include": ["settings/", "argv.json"]
        },
        {
          "id": "skills",
          "label": "Skills",
          "default_enabled": true,
          "include": ["skills/", "powers/"]
        },
        {
          "id": "steering",
          "label": "Steering",
          "default_enabled": true,
          "include": ["steering/"]
        },
        {
          "id": "extensions",
          "label": "Extensions",
          "default_enabled": false,
          "include": ["extensions/"]
        }
      ],
      "hard_exclude": ["Cache/", "CachedData/", "logs/"]
    },
    {
      "key": "aider",
      "label": "Aider",
      "root": {
        "kind": "home_subdir",
        "win": ".aider",
        "mac": ".aider",
        "env_override": null
      },
      "groups": [
        {
          "id": "config",
          "label": "配置",
          "default_enabled": true,
          "include": [".aider.conf.yml", "config.yml", "config.yaml"]
        },
        {
          "id": "history",
          "label": "历史",
          "default_enabled": false,
          "include": ["chat-history/", "history/"]
        }
      ],
      "hard_exclude": ["*.key", "cache/"]
    },
    {
      "key": "gemini",
      "label": "Gemini CLI",
      "root": {
        "kind": "home_subdir",
        "win": ".gemini",
        "mac": ".gemini",
        "env_override": null
      },
      "groups": [
        {
          "id": "config",
          "label": "配置",
          "default_enabled": true,
          "include": ["settings.json", "config.json", "GEMINI.md"]
        },
        {
          "id": "skills",
          "label": "Skills / Commands",
          "default_enabled": true,
          "include": ["skills/", "commands/", "extensions/"]
        },
        {
          "id": "history",
          "label": "历史",
          "default_enabled": false,
          "include": ["tmp/", "history/", "sessions/"]
        }
      ],
      "hard_exclude": ["tmp/", "cache/", "*.log"]
    }
  ]
}
